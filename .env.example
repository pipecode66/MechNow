# =============================================================================
# Mobile Mechanic Booking Platform — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your actual values.
# Never commit .env.local to version control.
# =============================================================================

# --- Supabase ---
# Found in your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-side only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Twilio SMS ---
# Found in your Twilio Console dashboard
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Phone number that receives admin SMS notifications (e.g. +15551234567)
ADMIN_PHONE_NUMBER=

# --- Google Maps ---
# Used for the map confirmation step in the booking flow.
# Restrict this key by HTTP referrer in the Google Cloud Console before production.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Session ---
# A long, random secret used to sign admin session tokens.
# Generate with: openssl rand -base64 32
SESSION_SECRET=
